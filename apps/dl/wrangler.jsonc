{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rf-dl",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "RF_CORE",
      "database_name": "rf-core",
      "database_id": "5f5ba177-402d-4faf-a67b-fcbda09fa94d",
      "migrations_dir": "../../packages/db/migrations/core"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RF_PRIVATE_BUCKET",
      "bucket_name": "rf-private"
    }
  ],
  "env": {
    "staging": {
      "name": "rf-dl-staging",
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "RF_CORE",
          "database_name": "rf-core-staging",
          "database_id": "d53bf307-ca60-4c5b-8276-b8a0f9b6327e",
          "migrations_dir": "../../packages/db/migrations/core"
        }
      ],
      "r2_buckets": [
        {
          "binding": "RF_PRIVATE_BUCKET",
          "bucket_name": "rf-private-staging"
        }
      ],
      "vars": {
        "WORKSPACE_ORIGIN": "https://staging.researchforce.org"
      },
      "routes": [{ "pattern": "dl-staging.researchforce.org", "custom_domain": true }]
    }
  },
  "vars": {
    "WORKSPACE_ORIGIN": "https://app.researchforce.org"
  },
  "routes": [{ "pattern": "dl.researchforce.org", "custom_domain": true }]
}
