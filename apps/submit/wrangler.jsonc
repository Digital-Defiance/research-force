{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rf-submit",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "RF_CORE",
      "database_name": "rf-core",
      "database_id": "5f5ba177-402d-4faf-a67b-fcbda09fa94d",
      "migrations_dir": "../../packages/db/migrations/core"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RF_PRIVATE_BUCKET",
      "bucket_name": "rf-private"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BUDGET",
        "class_name": "Budget",
        "script_name": "rf-app"
      },
      {
        "name": "MAILER",
        "class_name": "Mailer",
        "script_name": "rf-app"
      }
    ]
  },
  "vars": {
    "R2_ACCOUNT_ID": "48ca646fd701c00c0069952c95299dad",
    "PRIVATE_BUCKET_NAME": "rf-private"
  },
  "triggers": {
    // Hourly sweep of uploaded files not part of a complete Outside_Submission (R31.8).
    "crons": ["17 * * * *"]
  },
  "env": {
    "staging": {
      "name": "rf-submit-staging",
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "RF_CORE",
          "database_name": "rf-core-staging",
          "database_id": "d53bf307-ca60-4c5b-8276-b8a0f9b6327e",
          "migrations_dir": "../../packages/db/migrations/core"
        }
      ],
      "r2_buckets": [
        {
          "binding": "RF_PRIVATE_BUCKET",
          "bucket_name": "rf-private-staging"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "BUDGET",
            "class_name": "Budget",
            "script_name": "rf-app-staging"
          },
          {
            "name": "MAILER",
            "class_name": "Mailer",
            "script_name": "rf-app-staging"
          }
        ]
      },
      "vars": {
        "R2_ACCOUNT_ID": "48ca646fd701c00c0069952c95299dad",
        "PRIVATE_BUCKET_NAME": "rf-private-staging"
      },
      "routes": [{ "pattern": "submit-staging.researchforce.org", "custom_domain": true }],
      // No staging Cron Triggers: the account limit of 5 is reserved for production.
      "triggers": {
        "crons": []
      }
    }
  }
}
