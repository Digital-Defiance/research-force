{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rf-ops",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "preview_urls": false,
  // The durable external_operations record and the publication epoch live in rf-core (task 32.1, task 59.1).
  "d1_databases": [
    { "binding": "RF_CORE", "database_name": "rf-core", "database_id": "rf-core" }
  ],
  "env": {
    "staging": {
      "name": "rf-ops-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "CF_ACCOUNT_ID": "48ca646fd701c00c0069952c95299dad",
        "ACCESS_MEMBER_LIST_ID": "529ac5f1-5c53-4b10-8a5e-07ebba47389d"
      },
      "d1_databases": [
        { "binding": "RF_CORE", "database_name": "rf-core-staging", "database_id": "d53bf307-ca60-4c5b-8276-b8a0f9b6327e" }
      ]
    }
  }
}
