{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rf-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "routes": [{ "pattern": "app.researchforce.org", "custom_domain": true }],
  "vars": {
    "WORKSPACE_ORIGIN": "https://app.researchforce.org",
    "DOWNLOAD_ORIGIN": "https://dl.researchforce.org",
    "PUBLIC_SITE_ORIGIN": "https://researchforce.org",
    "PUBLIC_FILES_ORIGIN": "https://files.researchforce.org",
    "R2_ACCOUNT_ID": "48ca646fd701c00c0069952c95299dad",
    "PRIVATE_BUCKET_NAME": "rf-private",
    "PUBLIC_BUCKET_NAME": "rf-public",
    "BACKUP_COPY_BUDGET_APPROVED": "true",
    "BACKUP_RPO_WARN_HOURS": "576",
    "BACKUP_RPO_BREACH_HOURS": "744",
    "BACKUP_COPY_DESTINATION": "{\"kind\":\"offline\",\"label\":\"operator-local-drive\"}",
    "CONTENT_LICENCE_NAME": "CC BY 4.0",
    "CONTENT_LICENCE_URL": "https://creativecommons.org/licenses/by/4.0/"
  },
  "d1_databases": [
    {
      "binding": "RF_CORE",
      "database_name": "rf-core",
      "database_id": "5f5ba177-402d-4faf-a67b-fcbda09fa94d",
      "migrations_dir": "../../packages/db/migrations/core"
    },
    {
      "binding": "RF_SEARCH",
      "database_name": "rf-search",
      "database_id": "3b599490-1f42-45fa-8502-e32ebc5860f9",
      "migrations_dir": "../../packages/db/migrations/search"
    },
    {
      "binding": "RF_PUBLIC",
      "database_name": "rf-public",
      "database_id": "ddf0b4b8-f953-4724-a36e-77e21854694b",
      "migrations_dir": "../../packages/db/migrations/public"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RF_PRIVATE_BUCKET",
      "bucket_name": "rf-private"
    },
    {
      "binding": "RF_PUBLIC_BUCKET",
      "bucket_name": "rf-public"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PUBLISHER",
        "class_name": "Publisher"
      },
      {
        "name": "MAILER",
        "class_name": "Mailer"
      },
      {
        "name": "BUDGET",
        "class_name": "Budget"
      },
      {
        "name": "JOBS",
        "class_name": "Jobs"
      }
    ]
  },
  "services": [
    {
      "binding": "OPS",
      "service": "rf-ops"
    }
  ],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Publisher",
        "Mailer",
        "Budget",
        "Jobs"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *",
      "7 * * * *"
    ]
  },
  "env": {
    "staging": {
      "name": "rf-app-staging",
      "triggers": { "crons": [] },
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "WORKSPACE_ORIGIN": "https://staging.researchforce.org",
        "DOWNLOAD_ORIGIN": "https://dl-staging.researchforce.org",
        "PUBLIC_SITE_ORIGIN": "https://staging-public.researchforce.org",
        "PUBLIC_FILES_ORIGIN": "https://files-staging.researchforce.org",
        "R2_ACCOUNT_ID": "48ca646fd701c00c0069952c95299dad",
        "PRIVATE_BUCKET_NAME": "rf-private-staging",
        "PUBLIC_BUCKET_NAME": "rf-public-staging",
        "CONTENT_LICENCE_NAME": "CC BY 4.0",
        "CONTENT_LICENCE_URL": "https://creativecommons.org/licenses/by/4.0/"
      },
      "routes": [{ "pattern": "staging.researchforce.org", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "RF_CORE",
          "database_name": "rf-core-staging",
          "database_id": "d53bf307-ca60-4c5b-8276-b8a0f9b6327e",
          "migrations_dir": "../../packages/db/migrations/core"
        },
        {
          "binding": "RF_SEARCH",
          "database_name": "rf-search-staging",
          "database_id": "b4105b5e-b6bb-47e6-bc3b-8fe957e98dd4",
          "migrations_dir": "../../packages/db/migrations/search"
        },
        {
          "binding": "RF_PUBLIC",
          "database_name": "rf-public-staging",
          "database_id": "577fddc8-148f-4691-84a6-341aa6965e17",
          "migrations_dir": "../../packages/db/migrations/public"
        }
      ],
      "r2_buckets": [
        {
          "binding": "RF_PRIVATE_BUCKET",
          "bucket_name": "rf-private-staging"
        },
        {
          "binding": "RF_PUBLIC_BUCKET",
          "bucket_name": "rf-public-staging"
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "PUBLISHER",
            "class_name": "Publisher"
          },
          {
            "name": "MAILER",
            "class_name": "Mailer"
          },
          {
            "name": "BUDGET",
            "class_name": "Budget"
          },
          {
            "name": "JOBS",
            "class_name": "Jobs"
          }
        ]
      },
      "services": [
        {
          "binding": "OPS",
          "service": "rf-ops-staging"
        }
      ]
    }
  }
}
