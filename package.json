{
  "name": "research-force",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.21.1",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools"
  ],
  "scripts": {
    "lint": "oxlint && stylelint '**/*.css' && node scripts/check-boundaries.mjs && node --import tsx tools/lint-copy.ts",
    "typecheck": "node scripts/check-boundaries.mjs && tsc -b",
    "test": "vitest --run",
    "build": "npm run build --workspace @researchforce/app && npm run build --workspace @researchforce/site-shell",
    "ci": "npm run lint && npm run typecheck && npm test",
    "check:workers": "node scripts/check-workers.mjs",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle/core.config.ts && drizzle-kit generate --config packages/db/drizzle/search.config.ts && drizzle-kit generate --config packages/db/drizzle/public.config.ts",
    "test:nightly": "FC_RUNS=1000 vitest --run",
    "tools:export-metadata": "node --import tsx tools/export-attachment-metadata.ts",
    "tools:dry-run": "node --import tsx tools/migration-dry-run.ts",
    "design:fonts": "node --import tsx tools/vendor-fonts.ts && npm run design:css",
    "design:css": "node --import tsx tools/generate-design-css.ts"
  },
  "devDependencies": {
    "@capsizecss/metrics": "4.4.0",
    "@cloudflare/vitest-pool-workers": "npm:@cloudflare/vitest-plugin@1.4.8",
    "@cloudflare/workers-types": "5.20261027.1",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/stix-two-text": "5.3.0",
    "@fontsource/noto-sans-coptic": "5.3.0",
    "@fontsource/stix-two-math": "5.3.0",
    "@noble/hashes": "2.4.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/fontkit": "2.0.9",
    "@types/node": "^22.19.0",
    "@types/papaparse": "5.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "fast-check": "^4.3.0",
    "fontkit": "2.0.4",
    "happy-dom": "21.0.4",
    "hono": "^4.10.3",
    "oxlint": "^1.26.0",
    "papaparse": "5.7.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.4",
    "stylelint": "^16.25.0",
    "subset-font": "2.9.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "vitest": "~4.1.12",
    "wrangler": "^4.45.0",
    "zod": "4.6.6"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
