{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": ".cache/types",
    "tsBuildInfoFile": ".cache/tsconfig.tsbuildinfo",
    "types": [
      "node",
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "src/**/*.ts",
    "smoke/**/*.ts",
    "recovery/**/*.ts",
    "*.ts",
    "types/*.d.ts",
    "../infra/secrets.ts",
    "../infra/cloudflare/resources.ts",
    "../infra/cloudflare/provision.ts",
    "../infra/dns/records.ts"
  ],
  "references": [
    {
      "path": "../packages/domain"
    },
    {
      "path": "../packages/kernel"
    },
    {
      "path": "../packages/markdown"
    },
    {
      "path": "../packages/manifest"
    },
    {
      "path": "../packages/design"
    },
    {
      "path": "../packages/public-render"
    },
    {
      "path": "../packages/search-public"
    },
    {
      "path": "../packages/db"
    },
    {
      "path": "../packages/testing"
    }
  ]
}
