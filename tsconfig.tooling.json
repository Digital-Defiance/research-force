{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".cache/types",
    "tsBuildInfoFile": ".cache/tooling.tsbuildinfo",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types"
    ]
  },
  "include": [
    "vitest.config.ts",
    "apps/*/vite.config.ts",
    "apps/app/web/vite.config.ts",
    "packages/*/test/**/*.ts",
    "apps/*/test/**/*.ts"
  ],
  "references": [
    {
      "path": "packages/domain"
    },
    {
      "path": "packages/kernel"
    },
    {
      "path": "packages/markdown"
    },
    {
      "path": "packages/manifest"
    },
    {
      "path": "packages/design"
    },
    {
      "path": "packages/public-render"
    },
    {
      "path": "packages/search-public"
    },
    {
      "path": "packages/db"
    },
    {
      "path": "packages/testing"
    },
    {
      "path": "apps/app"
    },
    {
      "path": "apps/site-shell"
    },
    {
      "path": "apps/submit"
    },
    {
      "path": "apps/dl"
    },
    {
      "path": "apps/ops"
    },
    {
      "path": "tools"
    },
    {
      "path": "apps/app/web"
    }
  ]
}
